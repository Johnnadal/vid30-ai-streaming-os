# Vid30 AI Streaming OS — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# AWS Configuration (credentials are loaded from ~/.aws/credentials via `aws configure`)
AWS_REGION=eu-west-3

# Amazon Bedrock model to use for intent extraction
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0

# AI provider selection: "bedrock" (default) or "rule-based" (no AWS needed)
AI_PROVIDER=bedrock

# API server
PORT=3000
HOST=0.0.0.0
